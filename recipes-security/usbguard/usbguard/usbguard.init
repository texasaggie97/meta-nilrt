#!/bin/sh
### BEGIN INIT INFO
# Provides:          usbguard
# Required-Start:    $local_fs $syslog
# Required-Stop:     $local_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: USBGuard service
# Description:       Controls USB device authorization policies.
### END INIT INFO

DAEMON=/usr/sbin/usbguard-daemon
NAME=usbguard
DESC="USBGuard Service"
PIDFILE=/var/run/$NAME.pid
CONFIG_FILE=/etc/usbguard/usbguard-daemon.conf

start() {
    echo "Starting $DESC..."
    if [ -f $PIDFILE ]; then
        echo "$DESC is already running."
        return 1
    fi
    
    # Check configuration file exists
    if [ ! -f $CONFIG_FILE ]; then
        echo "Configuration file $CONFIG_FILE not found."
        return 1
    fi
    
    # Validate configuration
    $DAEMON --system --config $CONFIG_FILE --check-config
    if [ $? -ne 0 ]; then
        echo "Configuration validation failed."
        return 1
    fi
    
    start-stop-daemon --start --quiet --pidfile $PIDFILE --make-pidfile \
        --exec $DAEMON --background -- --system --config $CONFIG_FILE
    echo "$DESC started."
}

stop() {
    echo "Stopping $DESC..."
    if [ ! -f $PIDFILE ]; then
        echo "$DESC is not running."
        return 1
    fi
    start-stop-daemon --stop --quiet --pidfile $PIDFILE --retry 10
    rm -f $PIDFILE
    echo "$DESC stopped."
}

restart() {
    echo "Restarting $DESC..."
    stop
    start
}

status() {
    if [ -f $PIDFILE ]; then
        echo "$DESC is running."
    else
        echo "$DESC is not running."
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

